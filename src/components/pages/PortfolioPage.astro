---
import SocialMeta from '../SocialMeta.astro';
import NavigationEnhancements from '../NavigationEnhancements.astro';
import '../../styles/identity.css';
import CartographicLines from '../CartographicLines.astro';
import ExperienceSummary from '../ExperienceSummary.astro';
import LanguageSwitcher from '../LanguageSwitcher.astro';
import {portfolioCopy} from '../../i18n/portfolio';
interface Props {lang?: 'pt-BR'|'en-US'}
const {lang='en-US'}=Astro.props;
const en=lang==='en-US';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const home=`${base}/${en?'en/':''}`;
const pt=`${base}/portfolio/pt/`;
const english=`${base}/portfolio/`;
const canonical=new URL(en?english:pt,Astro.site).href;
const t=(key:string):string=>{if(en)return key;const value=portfolioCopy[key];if(value===undefined)throw new Error('Missing translation: '+key);return value;};
const experience = [
  {
    company: 'Wellhub',
    role: 'Global Learning & Development Intern',
    period: 'Jun 2024 — Mar 2026',
    scope: 'Global stakeholder coordination, employee experience, operational support and learning technology, including Degreed rollout support.'
  },
  {
    company: 'Reckitt',
    role: 'Talent Acquisition Intern',
    period: 'Nov 2022 — Jul 2024',
    scope: 'Full-cycle recruiting within an assigned Brazil portfolio spanning Early Careers, operational and factory, commercial and junior corporate roles.'
  },
  {
    company: 'TikTok',
    role: 'Talent Acquisition Center (Global)',
    period: 'Apr 2022 — Sep 2022',
    scope: 'High-volume recruiting support for US and EMEA teams, including sourcing, screening, scheduling, candidate communication and KPI tracking.'
  },
  {
    company: 'RealLife English',
    role: 'Customer Success Agent',
    period: 'Jan 2021 — Jan 2022',
    scope: 'Remote customer support and cross-cultural communication with an international user base.'
  }
];

const capabilities = [
  'Talent Acquisition',
  'Recruiting Operations',
  'International Recruiting',
  'Talent Sourcing',
  'Candidate Experience',
  'Early Careers',
  'Cross-cultural Communication',
  'People / Learning Operations'
];

const appliedAiCapabilities = [
  'Research and clear summaries with AI',
  'Making AI tools useful in everyday work',
  'Testing and improving ideas',
  'Organizing information and processes',
  'Connecting different AI tools'
];

const education = [
  {
    program: 'Psychology',
    institution: 'Universidade Paulista',
    period: '2022 — studies on hold; degree not completed'
  },
  {
    program: 'Law',
    institution: 'Universidade do Estado de Minas Gerais',
    period: '2018 — 2020; degree not completed'
  }
];

const languages = [
  'Portuguese — Native',
  'English — C1 / proficient',
  'Spanish — Basic to intermediate'
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Lucas Mateus da Silva',
  url: 'https://github.com/lucas-mateus-hq',
  sameAs: ['https://www.linkedin.com/in/lucasmateus/'],
  homeLocation: { '@type': 'Place', name: 'São Paulo, Brazil' },
  knowsAbout: capabilities
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="description" content={t("Lucas Mateus — Talent Acquisition and Recruiting Operations professional with international recruiting, sourcing, candidate experience and People / Learning Operations experience.")} />
    <meta name="theme-color" content="#071b20" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={`${base}/identity.svg`} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(pt,Astro.site).href} />
    <link rel="alternate" hreflang="en-US" href={new URL(english,Astro.site).href} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={t("Lucas Mateus — Talent Acquisition & Recruiting Operations")} />
    <meta property="og:description" content={t("Professional portfolio covering international recruiting, candidate experience, learning and selected personal AI projects.")} />
    <meta property="og:url" content={canonical} />
    <link rel="stylesheet" href={`${base}/fonts/fonts.css`} />
    <link rel="preload" href={`${base}/fonts/source-sans-3-latin.woff2`} as="font" type="font/woff2" crossorigin="anonymous" />
    <title>{t("Lucas Mateus — Talent Acquisition & Recruiting Operations")}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
    <SocialMeta lang={lang} />
  </head>
  <body>
    <header class="topbar">
      <a class="identity" href={home}>{t("← Lucas Mateus · Home")}</a>
      <nav class="portfolio-navigation" aria-label={t("Professional portfolio navigation")}>
        <a href="#experience">{t("Experience")}</a>
        <a href="#evidence">{t("Evidence")}</a>
        <a href="#background">{t("Background")}</a>
        <a href="#rnd">{t("AI projects")}</a>
        <a href="https://www.linkedin.com/in/lucasmateus/" rel="me">LinkedIn</a>
      </nav>
      <LanguageSwitcher lang={lang} pt={pt} en={english} />
    </header>

    <main id="top" class="journey-main"><CartographicLines />
      <section class="hero" aria-labelledby="page-title">
        <p class="eyebrow">{t("São Paulo, Brazil · Professional Portfolio")}</p>
        <h1 id="page-title">{t("Talent Acquisition &")}<br />{t("Recruiting Operations")}</h1>
        <ExperienceSummary lang={lang} className="positioning" />
        <div class="actions">
          <a class="primary" href="https://www.linkedin.com/in/lucasmateus/">{t("View LinkedIn")}</a>
          <a href="https://github.com/lucas-mateus-hq">{t("GitHub profile")}</a>
        </div>
      </section>

      <section class="capabilities" aria-labelledby="capabilities-title">
        <div class="section-label" id="capabilities-title">{t("Core capability areas")}</div>
        <div class="tag-grid">
          {capabilities.map((capability) => <span>{t(capability)}</span>)}
        </div>
      </section>

      <section id="experience" class="section">
        <header class="section-head">
          <span>01</span>
          <div>
            <p>{t("Professional experience")}</p>
            <h2>{t("Recruiting and coordination")}<br />{t("in international contexts.")}</h2>
          </div>
        </header>
        <div class="experience-list">
          {experience.map((item) => (
            <article>
              <div class="company">{item.company}</div>
              <div>
                <h3>{t(item.role)}</h3>
                <p>{t(item.scope)}</p>
              </div>
              <div class="period">{t(item.period)}</div>
            </article>
          ))}
        </div>
      </section>

      <section id="evidence" class="section evidence-section">
        <header class="section-head">
          <span>02</span>
          <div>
            <p>{t("Results and examples")}</p>
            <h2>{t("Examples from my work.")}</h2>
          </div>
        </header>
        <div class="evidence-grid">
          <article>
            <strong>{t("International sourcing")}</strong>
            <p>{t("For a Dublin search requiring Russian-language capability, used targeted Boolean sourcing and external communities; the role was filled in approximately one week.")}</p>
            <small>{t("TikTok · targeted sourcing example")}</small>
          </article>
          <article>
            <strong>{t("Candidate experience")}</strong>
            <p>{t("Q1 2023 candidate survey, n=15: 100% gave the maximum rating for TA contact, recruitment-stage clarity and role/company information; 14 of 15 (93%) gave the maximum overall experience rating.")}</p>
            <small>{t("Reckitt · candidate experience evidence")}</small>
          </article>
          <article>
            <strong>{t("Early Careers support")}</strong>
            <p>{t("Supported internship and apprentice recruiting and created a candidate preparation guide for a later recruitment stage.")}</p>
            <small>{t("Reckitt · recruiting operations")}</small>
          </article>
        </div>
      </section>

      <section id="rnd" class="section rnd-section">
        <header class="section-head">
          <span>03</span>
          <div>
            <p>{t("Projects with AI")}</p>
            <h2>{t("What I’m building and learning with AI.")}</h2>
          </div>
        </header>
        <div class="rnd-card">
          <div>
            <span class="badge">{t("Independent projects")}</span>
            <h3>{t("Using AI to learn and create")}</h3>
            <p>{t("I try practical ways to use AI for research, learning and creating useful materials. I share what I’ve tested, what worked and what still needs a person’s judgment.")}</p>
            <div class="mini-tag-grid">
              {appliedAiCapabilities.map((capability) => <span>{t(capability)}</span>)}
            </div>
            <p class="boundary">{t("These are personal experiments alongside my professional work, not a claim that every idea is a finished product.")}</p>
          </div>
          <a href={`${home}#criacoes`}>{t("Explore selected creations →")}</a>
        </div>
      </section>

      <section id="background" class="section">
        <header class="section-head">
          <span>04</span>
          <div>
            <p>{t("Education & languages")}</p>
            <h2>{t("Education and languages.")}</h2>
          </div>
        </header>
        <div class="profile-grid">
          <article class="profile-card">
            <strong>{t("Education")}</strong>
            {education.map((item) => (
              <div class="profile-item">
                <h3>{t(item.program)}</h3>
                <p>{item.institution} · {t(item.period)}</p>

              </div>
            ))}
          </article>
          <article class="profile-card">
            <strong>{t("Languages")}</strong>
            <ul>
              {languages.map((language) => <li>{t(language)}</li>)}
            </ul>
          </article>
        </div>
      </section>

      <section class="section interests">
        <header class="section-head">
          <span>05</span>
          <div>
            <p>{t("Current professional interests")}</p>
            <h2>{t("Areas I am interested in.")}</h2>
          </div>
        </header>
        <p>{t("Talent Acquisition · Recruiting Coordination · Recruiting Operations · Sourcing · Early Careers · International Recruiting · People / Learning Operations")}</p>
      </section>
    </main>

    <footer>
      <div>{t("Lucas Mateus da Silva · São Paulo, Brazil")}</div>
      <div class="links"><a href="https://www.linkedin.com/in/lucasmateus/">LinkedIn</a><a href="https://github.com/lucas-mateus-hq">GitHub</a></div>
      <p>{t("Professional portfolio · Recruiting, learning and personal AI projects.")}</p>
    </footer>
    <NavigationEnhancements />
  </body>
</html>

<style is:global>
  :root{--ink:#f7f3ea;--paper:#071b20;--line:#41595e;--muted:#bdccc9;--accent:#73cdba;color-scheme:dark}
  *{box-sizing:border-box}
  a:focus-visible{outline:3px solid var(--accent);outline-offset:5px}
  html{scroll-behavior:auto;background:var(--paper)}
  body{margin:0;background:var(--paper);color:var(--ink);font-family:"Source Sans 3",Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased}
  a{color:inherit}
  .topbar{position:sticky;top:0;z-index:10;display:flex;justify-content:space-between;align-items:center;gap:24px;min-height:64px;padding:0 28px;border-bottom:1px solid var(--line);background:rgba(7,27,32,.97);backdrop-filter:blur(10px)}
  .identity{font-weight:700;text-decoration:none}.topbar nav{display:flex;gap:22px}.topbar nav a{font-size:12px;text-decoration:none;color:var(--muted)}.topbar nav a:hover{color:var(--ink)}
  main,footer{width:min(100%,1480px);margin:0 auto;padding-left:28px;padding-right:28px}
  .hero{min-height:72vh;display:flex;flex-direction:column;justify-content:center;padding:80px 0;border-bottom:1px solid var(--ink)}
  .eyebrow,.section-label{font:600 10px "Source Sans 3",Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
  h1{font-family:"Source Sans 3",Arial,sans-serif;max-width:1200px;margin:18px 0 26px;font-size:clamp(56px,9vw,138px);line-height:.88;letter-spacing:-.04em;font-weight:400}
  .positioning{max-width:900px;margin:0;font-size:clamp(20px,2.3vw,34px);line-height:1.24;letter-spacing:-.035em;color:var(--muted)}
  .actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:34px}.actions a{display:inline-flex;align-items:center;min-height:42px;padding:0 16px;border:1px solid var(--line);text-decoration:none;font-size:12px}.actions .primary{background:var(--accent);color:#203039}
  .capabilities{padding:30px 0 60px;border-bottom:1px solid var(--ink)}.tag-grid{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.tag-grid span{padding:9px 12px;border:1px solid var(--line);font-size:11px;background:var(--brand-surface)}
  .section{padding:90px 0;border-bottom:1px solid var(--ink)}.section-head{display:grid;grid-template-columns:72px 1fr;gap:28px;margin-bottom:54px}.section-head>span{font:600 10px "Source Sans 3",Arial,sans-serif;color:var(--muted)}.section-head p{margin:0 0 12px;font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}.section-head h2{margin:0;font-size:clamp(42px,6vw,84px);line-height:.94;letter-spacing:-.06em;font-weight:500}
  .experience-list{border-top:1px solid var(--ink)}.experience-list article{display:grid;grid-template-columns:180px 1fr 180px;gap:28px;padding:24px 0;border-bottom:1px solid var(--line)}.experience-list article:last-child{border-bottom:0}.company{font-size:13px;font-weight:700}.experience-list h3{margin:0 0 8px;font-size:18px}.experience-list p{max-width:760px;margin:0;font-size:13px;line-height:1.6;color:var(--muted)}.period{text-align:right;font:500 11px "Source Sans 3",Arial,sans-serif;color:var(--muted)}
  .evidence-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--ink)}.evidence-grid article{min-height:300px;padding:26px 28px 28px 0;border-right:1px solid var(--line)}.evidence-grid article+article{padding-left:28px}.evidence-grid article:last-child{border-right:0}.evidence-grid strong{font-size:22px}.evidence-grid p{margin:72px 0 18px;font-size:14px;line-height:1.65}.evidence-grid small{font:500 10px "Source Sans 3",Arial,sans-serif;color:var(--muted)}
  .rnd-card{display:grid;grid-template-columns:1fr auto;gap:50px;align-items:end;padding:30px;border:1px solid var(--ink);background:var(--brand-surface)}.rnd-card>div{max-width:860px}.badge{color:var(--brand-copper);font:600 9px "Source Sans 3",Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em;color:var(--accent)}.rnd-card h3{margin:16px 0 12px;font-size:32px}.rnd-card p{margin:0 0 12px;font-size:14px;line-height:1.65}.boundary{color:var(--muted)}.rnd-card>a{font-size:12px;font-weight:700;text-decoration:none}
  .interests>p{max-width:1000px;margin:0 0 0 100px;font-size:clamp(22px,3vw,42px);line-height:1.3;letter-spacing:-.03em}
  footer{display:grid;grid-template-columns:1fr auto;gap:22px;padding-top:28px;padding-bottom:40px;font-size:11px;color:var(--muted)}footer .links{display:flex;gap:18px}footer p{grid-column:1/-1;max-width:900px;margin:0;font-size:10px;line-height:1.6}footer a{text-decoration:none}
  .profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.profile-card{border:1px solid var(--line);background:var(--brand-surface);padding:28px}.profile-card>strong{color:var(--accent);font-size:12px}.profile-item{margin-top:24px}.profile-item h3{font-size:18px;margin:0 0 8px}.profile-item p,.profile-card li{font-size:14px;line-height:1.7;color:var(--muted)}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
  @media(max-width:820px){.topbar nav a:not(:last-child){display:none}.section-head{grid-template-columns:1fr;gap:12px}.experience-list article{grid-template-columns:1fr}.period{text-align:left}.profile-grid{grid-template-columns:1fr}.evidence-grid{grid-template-columns:1fr}.evidence-grid article,.evidence-grid article+article{min-height:0;padding:24px 0;border-right:0;border-bottom:1px solid var(--line)}.evidence-grid article:last-child{border-bottom:0}.evidence-grid p{margin:30px 0 14px}.rnd-card{grid-template-columns:1fr}.interests>p{margin-left:0}}
  @media(max-width:560px){.topbar,main,footer{padding-left:18px;padding-right:18px}.hero{min-height:auto;padding:72px 0}.section{padding:64px 0}h1{font-size:clamp(48px,17vw,76px)}footer{grid-template-columns:1fr}.links{grid-column:1}}

  .experience-list p,.evidence-grid p,.rnd-card p,.profile-item p,.profile-card li{font-size:18px;line-height:1.7;max-width:62ch}
  h1{letter-spacing:-.045em;line-height:.98}.section-head h2{font-family:"Source Sans 3",Arial,sans-serif;font-weight:400;letter-spacing:-.025em;line-height:1.12}.positioning{letter-spacing:-.015em;line-height:1.45;max-width:62ch}.topbar nav a,.actions a{font-size:14px}.company{font-size:16px}.period{font-size:13px}.evidence-grid small{font-size:12px}.eyebrow,.section-label,.section-head>span,.section-head p,.badge{font-size:12px}

  .topbar{gap:16px;flex-wrap:wrap;padding-block:8px}.topbar>.identity{font-size:14px}.topbar>.portfolio-navigation{gap:18px}.topbar>.language-switch{margin-left:auto}
  @media(max-width:820px){.topbar{position:static}.topbar>.portfolio-navigation{display:none}}
  @media(max-width:560px){html[lang=pt-BR] #page-title{font-size:clamp(34px,11.2vw,52px)}}
  h1,.section-head h2{font-family:"Source Sans 3",Arial,sans-serif;font-weight:400;line-height:1.12;letter-spacing:-.025em}.actions a{border-radius:999px}.section-head>span{color:var(--brand-copper)}
  @media(max-width:560px){h1{font-size:clamp(34px,11.2vw,52px)}}
  h1{font-weight:700;line-height:1.08}.section-head h2{font-weight:600}.positioning{font-weight:400;line-height:1.6;max-width:60ch}.positioning strong{font-weight:600;color:var(--ink)}
  .rnd-card,.profile-card,.tag-grid span{background:var(--card-bg);border:1px solid var(--card-border);border-radius:var(--card-radius);backdrop-filter:var(--card-blur);-webkit-backdrop-filter:var(--card-blur);position:relative;z-index:0}
  .tag-grid span{border-radius:12px}.profile-grid{grid-template-columns:1.15fr .85fr}.rnd-card,.profile-card{padding:32px}.evidence-grid{gap:24px;border-top:0}.evidence-grid article,.evidence-grid article+article{background:var(--card-bg);border:1px solid var(--card-border);border-radius:var(--card-radius);padding:28px;backdrop-filter:var(--card-blur);position:relative;z-index:0}.evidence-grid article:last-child{border-right:1px solid var(--card-border)}
  .experience-list article{border-color:var(--card-border)}
  .rnd-card>div{min-width:0}.mini-tag-grid{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0}.mini-tag-grid span{max-width:100%;padding:6px 10px;border:1px solid var(--card-border);border-radius:10px;color:var(--accent);font-size:12px;line-height:1.5}.rnd-card>a{display:inline-flex;align-items:center;min-height:44px}
  @media(max-width:820px){.profile-grid{grid-template-columns:1fr}.rnd-card,.profile-card{padding:24px}.evidence-grid p{margin-top:24px}}
  #page-title{font-size:clamp(2rem,4vw,3.2rem);line-height:1.15;letter-spacing:-.02em;max-width:23ch}
  .section-head h2{font-size:clamp(2rem,4vw,3.2rem);line-height:1.15}
  .hero{min-height:0;padding-block:64px}
  @media(max-width:560px){html[lang] #page-title{font-size:clamp(2rem,4vw,3.2rem)}.hero{padding-block:40px}}
</style>
