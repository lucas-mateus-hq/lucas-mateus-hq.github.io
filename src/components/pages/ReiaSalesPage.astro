---
interface Props {
  canonicalUrl?: string;
}

const { canonicalUrl = 'https://pay.hotmart.com/I108167656O' } = Astro.props;

const pageTitle = "Renda Extra com IA: Teste, Entregue, Repita · Guia Prático por Lucas Mateus";
const pageDescription = "Guia prático de 72 páginas com 12 oportunidades reais de renda extra com inteligência artificial, ferramentas interativas exclusivas e plano de ação de 30 dias.";
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site?.origin || 'https://lucas-mateus-hq.github.io';
const canonicalPageUrl = `${site}${base}/renda-extra-com-ia/`;
const ogImageUrl = `${site}${base}/images/social-pt.png`;
const homeUrl = `${base}/`;
const privacyUrl = `${base}/privacidade/`;
const coverUrl = `${base}/images/reia-cover.webp`;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index,follow" />
    <link rel="icon" type="image/svg+xml" href={`${base}/identity.svg`} />
    <link rel="canonical" href={canonicalPageUrl} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalPageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Typography: Outfit via Google Fonts with local fallback -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet" />

    <style>
      :root {
        --reia-bg: #F5F0E8;
        --reia-surface: #EADFCC;
        --reia-surface-card: #FFFFFF;
        --reia-coral: #F57456;
        --reia-coral-hover: #E35D3E;
        --reia-rust: #93351F;
        --reia-rust-light: #B4462B;
        --reia-body: #172027;
        --reia-muted: #465057;
        --reia-border: rgba(147, 53, 31, 0.15);
        --reia-border-strong: rgba(147, 53, 31, 0.3);
        --font-outfit: "Outfit", "Source Sans 3", system-ui, -apple-system, sans-serif;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        background-color: var(--reia-bg);
        color: var(--reia-body);
        font-family: var(--font-outfit);
        font-size: 16px;
        line-height: 1.6;
        scroll-behavior: smooth;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }

      body {
        min-height: 100vh;
        background-color: var(--reia-bg);
        color: var(--reia-body);
      }

      /* Accessibility: Skip Link & Focus */
      .skip-link {
        position: fixed;
        top: 12px;
        left: 12px;
        z-index: 1000;
        background: var(--reia-rust);
        color: #FFFFFF;
        padding: 12px 20px;
        font-weight: 700;
        text-decoration: none;
        border-radius: 6px;
        transform: translateY(-160%);
        transition: transform 0.2s ease-in-out;
      }

      .skip-link:focus-visible {
        transform: translateY(0);
        outline: 3px solid var(--reia-rust);
        outline-offset: 3px;
      }

      :focus-visible {
        outline: 3px solid var(--reia-rust);
        outline-offset: 4px;
      }

      .container {
        width: min(1140px, calc(100% - 48px));
        margin-inline: auto;
      }

      /* Header / Top Navigation */
      .reia-header {
        border-bottom: 1px solid var(--reia-border);
        background: rgba(245, 240, 232, 0.95);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        position: sticky;
        top: 0;
        z-index: 100;
        padding: 16px 0;
      }

      .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
      }

      .site-brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--reia-rust);
        text-decoration: none;
      }

      .site-brand:hover {
        color: var(--reia-rust-light);
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--reia-muted);
        text-decoration: none;
        padding: 8px 14px;
        border-radius: 99px;
        border: 1px solid transparent;
        transition: all 0.2s ease;
      }

      .back-link:hover {
        color: var(--reia-rust);
        border-color: var(--reia-border-strong);
        background: var(--reia-surface);
      }

      /* Main container */
      main {
        outline: none;
      }

      /* Buttons & CTA - high contrast deep body text on coral (#172027 on #F57456 = 5.9:1 WCAG AA) */
      .cta-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        background-color: var(--reia-coral);
        color: var(--reia-body);
        font-weight: 700;
        font-size: 1.15rem;
        padding: 18px 36px;
        border-radius: 999px;
        text-decoration: none;
        box-shadow: 0 4px 16px rgba(245, 116, 86, 0.35);
        transition: transform 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
        border: 2px solid transparent;
        text-align: center;
      }

      .cta-button:hover {
        background-color: var(--reia-coral-hover);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(245, 116, 86, 0.45);
      }

      .cta-button:active {
        transform: translateY(0);
      }

      .cta-button.secondary {
        background-color: #FFFFFF;
        color: var(--reia-rust);
        border: 2px solid var(--reia-rust);
        box-shadow: none;
      }

      .cta-button.secondary:hover {
        background-color: var(--reia-surface);
        color: var(--reia-rust-light);
      }

      .cta-note {
        font-size: 0.85rem;
        color: var(--reia-muted);
        margin-top: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
      }

      /* Hero Section */
      .hero {
        padding: 72px 0 64px;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.25fr 0.95fr;
        gap: 56px;
        align-items: center;
      }

      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--reia-surface);
        color: var(--reia-rust);
        padding: 6px 16px;
        border-radius: 99px;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 24px;
        border: 1px solid var(--reia-border);
      }

      .hero h1 {
        font-size: clamp(2.4rem, 4.5vw, 3.8rem);
        line-height: 1.12;
        letter-spacing: -0.03em;
        font-weight: 800;
        color: var(--reia-rust);
        margin-bottom: 20px;
      }

      .hero-tagline {
        font-size: 1.25rem;
        line-height: 1.5;
        font-weight: 600;
        color: var(--reia-body);
        margin-bottom: 16px;
      }

      .hero-description {
        font-size: 1.1rem;
        line-height: 1.65;
        color: var(--reia-muted);
        margin-bottom: 32px;
      }

      .hero-actions {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
      }

      .hero-media {
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .cover-wrapper {
        position: relative;
        padding: 16px;
        background: #FFFFFF;
        border-radius: 20px;
        box-shadow: 0 16px 40px rgba(147, 53, 31, 0.12);
        border: 1px solid var(--reia-border);
        max-width: 380px;
        width: 100%;
      }

      .cover-image {
        width: 100%;
        height: auto;
        aspect-ratio: 1;
        border-radius: 12px;
        display: block;
        object-fit: cover;
      }

      .cover-badge {
        position: absolute;
        bottom: -14px;
        left: 50%;
        transform: translateX(-50%);
        background: var(--reia-rust);
        color: #FFFFFF;
        font-size: 0.8rem;
        font-weight: 700;
        padding: 6px 18px;
        border-radius: 99px;
        white-space: nowrap;
        box-shadow: 0 4px 12px rgba(147, 53, 31, 0.3);
      }

      /* Section Common */
      .section-heading {
        text-align: center;
        max-width: 780px;
        margin: 0 auto 52px;
      }

      .section-kicker {
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--reia-rust);
        margin-bottom: 12px;
      }

      .section-heading h2 {
        font-size: clamp(2rem, 3.2vw, 2.75rem);
        line-height: 1.2;
        letter-spacing: -0.02em;
        color: var(--reia-rust);
        margin-bottom: 16px;
      }

      .section-heading p {
        font-size: 1.15rem;
        color: var(--reia-muted);
      }

      /* Listicle: 5 Motivos Concretos */
      .listicle-section {
        padding: 88px 0;
        background-color: var(--reia-surface);
        border-top: 1px solid var(--reia-border);
        border-bottom: 1px solid var(--reia-border);
      }

      .listicle-grid {
        display: flex;
        flex-direction: column;
        gap: 28px;
        max-width: 920px;
        margin: 0 auto;
      }

      .listicle-card {
        background: #FFFFFF;
        border-radius: 20px;
        padding: 36px 36px;
        border: 1px solid var(--reia-border);
        box-shadow: 0 8px 24px rgba(147, 53, 31, 0.05);
        display: grid;
        grid-template-columns: 64px 1fr;
        gap: 28px;
        align-items: flex-start;
      }

      .listicle-badge-col {
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .listicle-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--reia-rust);
        color: #FFFFFF;
        font-weight: 800;
        font-size: 1.4rem;
        box-shadow: 0 4px 12px rgba(147, 53, 31, 0.25);
      }

      .listicle-body h3 {
        font-size: 1.45rem;
        line-height: 1.3;
        font-weight: 700;
        color: var(--reia-rust);
        margin-bottom: 14px;
      }

      .listicle-body .pain-point {
        font-size: 0.98rem;
        color: var(--reia-muted);
        line-height: 1.6;
        margin-bottom: 16px;
        padding-bottom: 14px;
        border-bottom: 1px dashed var(--reia-border);
      }

      .listicle-body .solution-detail {
        font-size: 1.02rem;
        color: var(--reia-body);
        line-height: 1.6;
        margin-bottom: 16px;
      }

      .listicle-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--reia-rust);
        background: var(--reia-surface);
        padding: 6px 14px;
        border-radius: 99px;
        border: 1px solid var(--reia-border);
      }

      /* Deliverables Cards */
      .deliverables-section {
        padding: 96px 0;
      }

      .cards-grid-four {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 32px;
      }

      .card-deliverable {
        background: #FFFFFF;
        border-radius: 20px;
        padding: 36px 32px;
        border: 1px solid var(--reia-border);
        box-shadow: 0 8px 28px rgba(147, 53, 31, 0.06);
        display: flex;
        flex-direction: column;
      }

      .deliverable-badge {
        align-self: flex-start;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        background: rgba(245, 116, 86, 0.15);
        color: var(--reia-rust);
        padding: 5px 12px;
        border-radius: 99px;
        margin-bottom: 18px;
      }

      .card-deliverable h3 {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--reia-rust);
        line-height: 1.3;
        margin-bottom: 14px;
      }

      .card-deliverable p {
        font-size: 1rem;
        color: var(--reia-muted);
        line-height: 1.65;
        margin-bottom: 20px;
      }

      .card-deliverable ul {
        list-style: none;
        margin-top: auto;
        padding-top: 16px;
        border-top: 1px solid var(--reia-border);
      }

      .card-deliverable li {
        font-size: 0.92rem;
        color: var(--reia-body);
        margin-bottom: 8px;
        display: flex;
        align-items: flex-start;
        gap: 8px;
      }

      .card-deliverable li::before {
        content: "✓";
        color: var(--reia-rust);
        font-weight: 700;
        flex-shrink: 0;
      }

      /* FAQ Section */
      .faq-section {
        padding: 88px 0;
        background-color: var(--reia-surface);
        border-top: 1px solid var(--reia-border);
        border-bottom: 1px solid var(--reia-border);
      }

      .faq-list {
        max-width: 840px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .faq-item {
        background: #FFFFFF;
        border: 1px solid var(--reia-border);
        border-radius: 14px;
        padding: 24px 28px;
        box-shadow: 0 4px 12px rgba(147, 53, 31, 0.04);
      }

      .faq-question {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--reia-rust);
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .faq-answer {
        font-size: 1rem;
        color: var(--reia-muted);
        line-height: 1.65;
      }

      /* Author Section */
      .author-section {
        padding: 88px 0;
      }

      .author-card {
        background: #FFFFFF;
        border-radius: 24px;
        border: 1px solid var(--reia-border);
        padding: 48px;
        box-shadow: 0 12px 36px rgba(147, 53, 31, 0.06);
        max-width: 920px;
        margin: 0 auto;
      }

      .author-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 24px;
        border-bottom: 1px solid var(--reia-border);
        padding-bottom: 20px;
      }

      .author-portrait {
        display: block;
        width: 112px;
        height: 112px;
        flex: 0 0 112px;
        border-radius: 50%;
        object-fit: cover;
        object-position: center 25%;
        border: 3px solid var(--reia-surface);
      }

      .author-header .kicker {
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--reia-rust);
        margin-bottom: 6px;
      }

      .author-header h2 {
        font-size: 2.2rem;
        color: var(--reia-rust);
        font-weight: 800;
      }

      .author-content p {
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--reia-body);
        margin-bottom: 18px;
      }

      .author-links {
        margin-top: 28px;
        display: flex;
        gap: 20px;
        align-items: center;
        flex-wrap: wrap;
      }

      .author-link {
        font-weight: 600;
        color: var(--reia-rust);
        text-decoration: underline;
        text-underline-offset: 4px;
      }

      .author-link:hover {
        color: var(--reia-rust-light);
      }

      /* Guarantee & Direct Checkout */
      .guarantee-section {
        padding: 96px 0 88px;
        text-align: center;
      }

      .guarantee-box {
        background: #FFFFFF;
        border: 2px solid var(--reia-rust);
        border-radius: 24px;
        padding: 56px 40px;
        max-width: 800px;
        margin: 0 auto;
        box-shadow: 0 16px 48px rgba(147, 53, 31, 0.08);
      }

      .guarantee-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: var(--reia-surface);
        color: var(--reia-rust);
        font-size: 1.8rem;
        font-weight: 800;
        margin-bottom: 20px;
      }

      .guarantee-box h2 {
        font-size: clamp(1.8rem, 3vw, 2.4rem);
        color: var(--reia-rust);
        font-weight: 800;
        margin-bottom: 16px;
      }

      .guarantee-box p {
        font-size: 1.1rem;
        line-height: 1.65;
        color: var(--reia-muted);
        margin-bottom: 32px;
        max-width: 620px;
        margin-inline: auto;
      }

      .guarantee-actions {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
      }

      /* Footer */
      .reia-footer {
        background-color: var(--reia-surface);
        border-top: 1px solid var(--reia-border);
        padding: 48px 0 36px;
        font-size: 0.9rem;
        color: var(--reia-muted);
      }

      .footer-nav {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 14px 28px;
        margin-bottom: 32px;
      }

      .footer-nav a {
        color: var(--reia-rust);
        font-weight: 600;
        text-decoration: none;
      }

      .footer-nav a:hover {
        text-decoration: underline;
      }

      .footer-bottom {
        border-top: 1px solid var(--reia-border);
        padding-top: 24px;
        text-align: center;
        font-size: 0.85rem;
      }

      /* Responsive Breakpoints */
      @media (max-width: 960px) {
        .hero-grid {
          grid-template-columns: 1fr;
          gap: 48px;
          text-align: center;
        }

        .hero-actions {
          align-items: center;
        }

        .cards-grid-four {
          grid-template-columns: 1fr;
        }

      }

      @media (max-width: 640px) {
        .container {
          width: calc(100% - 32px);
        }

        .hero {
          padding: 48px 0 40px;
        }

        .listicle-card {
          grid-template-columns: 1fr;
          gap: 16px;
          padding: 24px 20px;
        }

        .listicle-badge-col {
          align-items: flex-start;
        }

        .faq-item {
          padding: 20px 18px;
        }

        .cta-button {
          width: 100%;
          padding: 16px 24px;
          font-size: 1.05rem;
        }

        .author-card {
          padding: 32px 20px;
        }

        .author-header {
          gap: 16px;
        }

        .author-header h2 {
          font-size: clamp(1.6rem, 6vw, 2.2rem);
        }

        .author-portrait {
          width: 84px;
          height: 84px;
          flex-basis: 84px;
        }

        .guarantee-box {
          padding: 36px 20px;
        }
      }
    </style>
  </head>
  <body>
    <a href="#reia-main" class="skip-link">Pular para o conteúdo principal</a>

    <!-- Top Navigation Header -->
    <header class="reia-header" role="banner">
      <div class="container header-content">
        <a href={homeUrl} class="site-brand">
          <span>Lucas Mateus</span>
        </a>
        <a href={homeUrl} class="back-link">
          <span aria-hidden="true">←</span>
          <span>Voltar ao site</span>
        </a>
      </div>
    </header>

    <!-- Main Content Container with tabindex="-1" for skip link focus -->
    <main id="reia-main" tabindex="-1">
      <!-- 1. Hero Section -->
      <section class="hero" aria-labelledby="hero-title">
        <div class="container hero-grid">
          <div class="hero-content">
            <span class="hero-badge">Guia Prático + Ferramentas Interativas</span>
            <h1 id="hero-title">Renda Extra com IA: Teste, Entregue, Repita</h1>
            <p class="hero-tagline">Menos ideias no papel. Mais resultados na prática.</p>
            <p class="hero-description">
              Está cansado de pesquisar formas de ganhar dinheiro com inteligência artificial e não saber por onde começar? Transforme suas ideias em um serviço real para oferecer a clientes e conquistar sua renda extra com segurança.
            </p>
            <div class="hero-actions">
              <a
                href={canonicalUrl}
                class="cta-button"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>Garantir Acesso na Hotmart</span>
                <span aria-hidden="true">→</span>
              </a>
              <span class="cta-note">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                Pagamento e acesso gerenciados pela Hotmart
              </span>
            </div>
          </div>
          <div class="hero-media">
            <div class="cover-wrapper">
              <img
                src={coverUrl}
                alt="Capa do e-book Renda Extra com IA: Teste, Entregue, Repita"
                class="cover-image"
                width="300"
                height="300"
                loading="eager"
              />
              <span class="cover-badge">Material Digital Completo</span>
            </div>
          </div>
        </div>
      </section>

      <!-- 2. Listicle: 5 Motivos Concretos para Utilizar o REIA -->
      <section class="listicle-section" aria-labelledby="listicle-title">
        <div class="container">
          <header class="section-heading">
            <span class="section-kicker">Por Que o REIA Funciona</span>
