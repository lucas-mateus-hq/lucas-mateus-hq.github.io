---
import PersonalLayout from '../../layouts/PersonalLayout.astro';
interface Props {lang?: 'pt-BR'|'en-US'}
const {lang='pt-BR'}=Astro.props;
const en=lang==='en-US';
const c=(pt:string,us:string)=>en?us:pt;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const portfolio=`${base}/portfolio/${en?'':'pt/'}`;
const steps=en?[
 ['Application','Share your résumé and a real or hypothetical job description. I review the fit before we arrange payment.'],
 ['30-minute initial session','We identify your target, relevant experience, and what needs practice.'],
 ['Two 60-minute sessions','We use the Interview Map to organize examples and rehearse your answers in English.'],
 ['Written feedback','Receive your report and Interview Map within 3 business days after the final session.']
]:[
 ['Aplicação','Envie seu currículo e uma vaga real ou hipotética. Avalio o encaixe antes de combinarmos o pagamento.'],
 ['Sessão inicial de 30 minutos','Identificamos seu objetivo, as experiências relevantes e o que precisa de prática.'],
 ['Duas sessões de 60 minutos','Aplicamos o Interview Map para organizar exemplos e ensaiar suas respostas em inglês.'],
 ['Devolutiva escrita','Receba seu relatório e Interview Map em até 3 dias úteis após a última sessão.']
];
---
<PersonalLayout lang={lang} path={en?'en/':''} ptPath="" enPath="en/" title={c('Lucas Mateus · Preparação para entrevistas em inglês','Lucas Mateus · English interview preparation')} description={c('Acompanhamento individual para transformar sua experiência profissional em respostas claras em entrevistas em inglês. Conheça o pacote e como aplicar.','Recruiting, global learning, and practical AI projects by Lucas Mateus, based in São Paulo.')}>
 <section class="hero wrap interview-hero" aria-labelledby="home-title">
  <div class="hero-copy">
   <p class="eyebrow">01 / Lucas Mateus · São Paulo</p>
   <h1 id="home-title">{c('Sua experiência no Brasil.','Your experience in Brazil.')}<br/><em>{c('Sua próxima entrevista em inglês.','Your next interview in English.')}</em></h1>
   <p class="hero-intro">{c('Você já construiu uma trajetória. Vamos trabalhar como apresentá-la em inglês, com exemplos e prática individual. Reúno minha experiência em processos seletivos internacionais e no ensino de inglês para ajudar você a preparar suas respostas. O primeiro passo é aplicar para o acompanhamento.','You’ve built your career. Let’s work on how you present it in English, with relevant examples and individual practice. I draw on my experience in international recruiting and English teaching to help you prepare your answers.')}</p>
   <div class="actions">{!en && <a class="button primary" href="#aplicacao">{c('Aplicar para o acompanhamento','Apply for individual support')} <span aria-hidden="true">↗</span></a>}<a class="text-link" href={portfolio}>{c('Conheça meu trabalho','Explore my work')} <span aria-hidden="true">↗</span></a><a class="text-link" href="#criacoes">{c('Explore minhas criações','Explore my creations')} <span aria-hidden="true">↓</span></a></div>
  </div>
  <figure class="portrait-note"><div class="portrait-frame"><img src={`${base}/lucas-mateus.webp`} alt="Lucas Mateus" width="360" height="420" decoding="async" /></div><figcaption><strong>{c('Recrutamento internacional e mais de cinco anos ensinando inglês.','International recruiting and more than five years teaching English.')}</strong><span>Wellhub · Reckitt · TikTok</span></figcaption></figure>
 </section>
 {!en && <section class="band work-band service-band" id="trabalho" aria-labelledby="service-title"><div class="wrap">
  <header class="section-heading"><div><p class="section-number">02 / {c('Acompanhamento individual','Individual support')}</p><h2 id="service-title">{c('Acompanhamento Individual para Entrevistas em Inglês','Individual English Interview Preparation')}</h2></div></header>
  <div class="service-summary"><p class="service-lead">{c('Trabalhe o que você tem a dizer e pratique como dizer. Um acompanhamento com foco na sua trajetória e na vaga que você quer buscar.','Work on what you want to say and practice how to say it. Individual support centered on your background and the role you want to pursue.')}</p><p class="package-price"><span>{c('Pacote completo: 30 min + 2 × 60 min','Complete package: 30 min + 2 × 60 min')}</span></p></div>
  <ol class="interview-route">{steps.map(([title,text],i)=><li><span class="route-node" aria-hidden="true">{i+1}</span><h3>{title}</h3><p>{text}</p></li>)}</ol>
  <p class="service-callout">{c('Sessões por videochamada. Relatório e aplicação prática do Interview Map incluídos. Pagamento via Hotmart após aprovação da aplicação e antes da primeira sessão.','Sessions by video call. Written report and practical use of the Interview Map included. Payment through Hotmart after your application is approved and before your first session.')}</p>
  <div class="fit-grid"><div><h3>{c('Para quem faz sentido','Who it’s for')}</h3><p>{c('Profissionais que precisam organizar e praticar respostas em inglês. Você pode trazer uma entrevista marcada ou uma vaga hipotética para orientar a preparação.','Professionals who need to organize and practice answers in English. You can bring an upcoming interview or a hypothetical role to guide your preparation.')}</p></div><div><h3>{c('O que esperar','What to expect')}</h3><p>{c('Preparação focada em entrevistas, sem promessa de contratação. O pacote não é um curso de inglês do zero nem um serviço de indicação para vagas.','Focused interview preparation, with no promise of a job offer. This package does not teach English from scratch or provide job referrals.')}</p></div></div>
  <div class="service-faq"><h3>{c('Antes de aplicar','Before you apply')}</h3>{[
   [c('Preciso ter uma entrevista marcada?','Do I need an interview scheduled?'),c('Não. Uma vaga hipotética também serve para direcionar os exemplos e a prática.','No. A hypothetical role can also guide your examples and practice.')],
   [c('Quando eu pago?','When do I pay?'),c('Depois que eu avaliar e aprovar sua aplicação, combinamos o pagamento pela Hotmart, antes da primeira sessão. O investimento é definido nessa análise, conforme o seu caso. Aplicar não gera cobrança.','After I review and approve your application, we arrange payment through Hotmart before the first session. The investment is set in that review, based on your case. Applying does not create a charge.')],
   [c('Como acontecem as sessões e as entregas?','How do sessions and delivery work?'),c('São três encontros por videochamada: 30 minutos, 60 minutos e 60 minutos. Envio o relatório e o Interview Map por e-mail em até 3 dias úteis após o último encontro.','We meet three times by video call: 30 minutes, 60 minutes, and 60 minutes. I email your report and Interview Map within 3 business days after the final session.')]
  ].map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div>
  <section id="aplicacao" class="application-panel" aria-labelledby="application-title" data-locale-section><h3 id="application-title">{c('Aplicações em preparação','Applications are being prepared')}</h3><p>{c('Ainda não é possível enviar sua aplicação por esta página. O acompanhamento abrirá quando o recebimento estiver pronto.','You can’t submit an application on this page yet. Applications will open once the form is ready to receive them.')}</p></section>
 </div></section>}
 <section class="band creation-band" id="criacoes" aria-labelledby="creation-title"><div class="wrap"><header class="section-heading"><div><p class="section-number">{en?'02':'03'} / {c('Produtos','Products')}</p><h2 id="creation-title">{c('Um guia para colocar ideias em prática.','A guide to put ideas into practice.')}</h2></div></header><article class="reia-feature" id="reia"><img src={`${base}/images/reia-cover.webp`} class="reia-feature-art" alt={c('Capa do guia REIA','Cover of the REIA guide')} width="96" height="96" loading="lazy"/><div class="reia-feature-copy"><span class="status">{c('Disponível agora','Available in Portuguese')}</span><h3>Renda Extra com IA: Teste, Entregue, Repita</h3><p>{c('Guia com 12 oportunidades de serviços com IA, ferramentas interativas e plano de ação de 30 dias. Compra e entrega pela Hotmart.','A guide with 12 AI service opportunities, interactive tools, and a 30-day action plan. Content and checkout are in Portuguese.')}</p><a class="text-link" href={`${base}/renda-extra-com-ia/`}>{c('Conheça o REIA','Explore the REIA guide (Portuguese)')} ↗</a></div><a class="text-link" href="https://pay.hotmart.com/I108167656O">{c('Comprar pela Hotmart','Buy through Hotmart (Portuguese)')} ↗</a></article></div></section>
 <section class="band ideas-band editorial-light" id="escritos" aria-labelledby="proof-title"><div class="wrap"><header class="section-heading"><div><p class="section-number">{en?'03':'04'} / {c('Experiência na prática','Experience in practice')}</p><h2 id="proof-title">{c('O repertório por trás do acompanhamento.','The experience behind the preparation.')}</h2></div></header><div class="proof-grid"><article><strong>~1 {c('semana','week')}</strong><p>{c('Em uma busca em Dublin que exigia russo, usei sourcing Boolean direcionado e comunidades externas. A vaga foi preenchida em aproximadamente uma semana.','For a Dublin search requiring Russian-language capability, I used targeted Boolean sourcing and external communities. The role was filled in approximately one week.')}</p></article><article><strong>15 {c('respostas','responses')}</strong><p>{c('Pesquisa Reckitt, Q1 2023: 100% deram nota máxima ao contato com TA, clareza das etapas e informações sobre vaga/empresa. Na experiência geral, foram 14 de 15 (93%).','Reckitt candidate survey, Q1 2023: 100% gave the maximum rating for TA contact, stage clarity, and role/company information. Overall experience: 14 of 15 (93%).')}</p></article></div><p class="evidence-note">{c('São exemplos de atuação profissional, não resultados de clientes deste serviço.','These examples reflect professional work, not client outcomes from this service.')} <a class="text-link" href={`${portfolio}#evidence`}>{c('Ver contexto no portfólio','See the portfolio evidence')} ↗</a></p><div class="recommendation-list"><h3>{c('Pessoas que acompanharam meu trabalho','People who have worked with me')}</h3><ul><li><strong>Chris Silva Upson</strong><span>{c('Gestor direto na Wellhub','Direct manager at Wellhub')}</span></li><li><strong>Gustavo Chaves</strong><span>{c('Ex-aluno, setor financeiro','Former student, financial sector')}</span></li><li><strong>Leo Labra</strong><span>{c('Contato profissional no TikTok','Professional connection at TikTok')}</span></li></ul><a class="text-link" href="https://www.linkedin.com/in/lucasmateus/">{c('Ver perfil e recomendações no LinkedIn','View profile and recommendations on LinkedIn')} ↗</a></div></div></section>
 <section class="band about-band editorial-light" id="sobre" aria-labelledby="about-title"><div class="wrap about"><div><p class="section-number">{en?'04':'05'} / {c('Trajetória e sobre','Background and about')}</p><h2 id="about-title">{c('Prazer,','Hi, I’m')}<br/><em>Lucas Mateus.</em></h2></div><div class="about-copy"><p class="about-lead">{c('Gosto de entender o contexto antes de chegar a uma resposta.','I like understanding the context before settling on an answer.')}</p><p>{c('Minha trajetória reúne recrutamento na TikTok e Reckitt, aprendizagem global na Wellhub, atendimento internacional na RealLife English e mais de cinco anos ensinando inglês.','My background includes recruiting at TikTok and Reckitt, global learning at Wellhub, international customer support at RealLife English, and more than five years teaching English.')}</p><p>{c('Também crio projetos práticos com inteligência artificial. Me interessa o que podemos aprender e construir juntos, com espaço para questionar o resultado.','I also build practical projects with AI. I’m interested in what we can learn and create together while making room to question the results.')}</p><a class="text-link" href={portfolio}>{c('Portfólio completo','Full professional portfolio')} ↗</a></div></div></section>
 <section class="contact-band" id="contato" aria-labelledby="contact-title"><div class="wrap contact"><div><h2 id="contact-title">{c('Vamos conversar sobre trabalho ou projetos?','Let’s talk about work or projects.')}</h2>{!en && <p>{c('Para o acompanhamento, use a área de aplicação acima quando estiver disponível.','For interview preparation, use the application section above when it becomes available.')}</p>}</div><a class="text-link" href="https://www.linkedin.com/in/lucasmateus/">{c('Entrar em contato','Get in touch')} ↗</a></div></section>
</PersonalLayout>
