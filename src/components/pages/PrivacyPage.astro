---
import {lessonIntake} from '../../config/lesson-intake';
import SocialMeta from '../SocialMeta.astro';
import NavigationEnhancements from '../NavigationEnhancements.astro';
import '../../styles/identity.css';
import LanguageSwitcher from '../LanguageSwitcher.astro';
import {privacyCopy,privacySections} from '../../i18n/privacy';
interface Props {lang?: 'pt-BR'|'en-US'}
const {lang='en-US'}=Astro.props;
const en=lang==='en-US';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const pt=`${base}/privacidade/`;
const english=`${base}/privacy/`;
const canonical=new URL(en?english:pt,Astro.site).href;
const portfolio=`${base}/portfolio/${en?'':'pt/'}`;
const t=(key:string):string=>{if(en)return key;const value=privacyCopy[key];if(value===undefined)throw new Error('Missing translation: '+key);return value;};
const updated=en?'October 25, 2026':'25 de outubro de 2026';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index,follow" />
    <meta name="description" content={t("Privacy notice for Lucas Mateus’s personal website, hosting.")} />
    <link rel="icon" type="image/svg+xml" href={`${base}/identity.svg`} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(pt,Astro.site).href} />
    <link rel="alternate" hreflang="en-US" href={new URL(english,Astro.site).href} />
    <link rel="stylesheet" href={`${base}/fonts/fonts.css`} />
    <title>{t("Privacy Policy — Lucas Mateus")}</title>
    <style>
      :root { font-family: "Source Sans 3", Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #f7f3ea; background: #071b20; }
      * { box-sizing: border-box; }
      body { margin: 0; }
      .privacy-languages{width:min(760px,calc(100% - 40px));margin:0 auto;display:flex;justify-content:flex-end;padding-top:20px}
      main { width: min(760px, calc(100% - 40px)); margin: 0 auto; padding: 28px 0 96px; }
      a { color: inherit; }
      .back { display: inline-block; margin-bottom: 48px; font-size: .92rem; }
      .eyebrow { text-transform: uppercase; letter-spacing: .12em; font-size: .75rem; }
      h1 { font-family:"Source Sans 3",Arial,sans-serif; font-weight:700; font-size: clamp(2.4rem, 7vw, 4.5rem); line-height: 1.15; letter-spacing: -.045em; margin: 12px 0 20px; }
      .lead { font-size: 1.16rem; line-height: 1.65; max-width: 680px; }
      .updated { margin: 28px 0 52px; font-size: .9rem; opacity: .7; }
      section { border-top: 1px solid #41595e; padding: 28px 0; }
      h2 { font-family:"Source Sans 3",Arial,sans-serif; font-weight:600; margin: 0 0 12px; font-size: 1.15rem; }
      .policy-link{margin-top:16px}.policy-link a,li a{display:inline-flex;align-items:center;min-height:44px}ul{padding-left:20px}li{line-height:1.7;margin-bottom:8px}
      p { font-size: 18px; line-height: 1.7; margin: 0; max-width: 62ch; }
    </style>
    <meta property="og:title" content={t("Privacy Policy — Lucas Mateus")} />
    <meta property="og:description" content={t("Privacy notice for Lucas Mateus’s personal website, hosting.")} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <SocialMeta lang={lang} />
  </head>
  <body>
    <header class="privacy-languages"><LanguageSwitcher lang={lang} pt={pt} en={english} /></header>
    <main>
      <a class="back" href={portfolio}>{t("← Professional portfolio")}</a>
      <p class="eyebrow">{t("Lucas Mateus · Privacy")}</p>
      <h1>{t("Privacy Policy")}</h1>
      <p class="lead">{lessonIntake.active?(en?"This notice explains browsing, lesson inquiries and the providers involved in responding to them.":"Este aviso explica a navegação, as solicitações de aulas e os provedores envolvidos no atendimento."):(en?"This notice explains hosting, the local mock interview message form and what happens when you choose to contact me.":"Este aviso explica a hospedagem, o formulário local de simulação e o que acontece quando você decide entrar em contato.")}</p>
      <p class="updated"><strong>{t("Last updated:")}</strong> {updated}</p>

      {privacySections.map(section=><section id={section.id}><h2>{t(section.title)}</h2><p>{t(section.text)}</p>{section.id==='contact'||section.id==='rights'?<p class="policy-link"><a href="https://www.linkedin.com/in/lucasmateus/">{t("Contact Lucas on LinkedIn")} ↗</a></p>:null}</section>)}
      <section id="references"><h2>{t("Provider policies and your rights")}</h2><ul>
        <li><a href="https://docs.github.com/en/pages/getting-started-with-github-pages/what-is-github-pages">{t("GitHub Pages hosting")}</a></li>
        <li><a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">{t("GitHub privacy statement")}</a></li>
        {lessonIntake.active && <li><a href="https://www.cloudflare.com/privacypolicy/">{en?'Cloudflare privacy policy':'Política de privacidade da Cloudflare'}</a></li>}
        {lessonIntake.active && <li><a href="https://www.whatsapp.com/legal/business-data-processing-terms">{en?'WhatsApp Business data processing terms':'Termos de tratamento de dados do WhatsApp Business'}</a></li>}
        <li><a href="https://www.gov.br/anpd/pt-br/assuntos/titular-de-dados/direito-dos-titulares">{t("Your rights under the LGPD (ANPD)")}</a></li>
      </ul></section>
    </main>
    <NavigationEnhancements />
  </body>
</html>
