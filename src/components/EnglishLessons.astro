---
import {lessonIntake} from '../config/lesson-intake';
import LessonRequestForm from './LessonRequestForm.astro';
import MockInterviewRequestForm from './MockInterviewRequestForm.astro';
interface Props {lang: 'pt-BR'|'en-US'}
const {lang}=Astro.props;
const en=lang==='en-US';
const {active,api,siteKey}=lessonIntake;
const privacy=en?'/privacy/':'/privacidade/';
---
<section class="band lessons-band" id="aulas" aria-labelledby="lessons-title">
  <div class="wrap">
    <header class="section-heading"><div><p class="section-number">{en?'02 / English lessons':'02 / Aulas de inglês'}</p><h2 id="lessons-title">{en?'English for interviews':'Inglês para entrevistas'}<br/><em>{en?'and everyday work.':'e situações reais de trabalho.'}</em></h2></div></header>
    <p class="lessons-intro">{en?'More than five years teaching English, with experience in international recruiting and corporate learning. Practice and feedback focused on what you need to communicate.':'Mais de cinco anos ensinando inglês, com experiência em recrutamento internacional e aprendizagem corporativa. Prática e feedback voltados ao que você precisa comunicar.'}</p>
    <article class="mock-offer" aria-labelledby="mock-offer-title">
      <div class="mock-offer-content">
        <p class="label">{en?'One-off service · practical preparation':'Serviço avulso · preparação prática'}</p>
        <h3 id="mock-offer-title">{en?'60-minute mock job interview in English':'Simulação de entrevista em inglês · 1 hora'}</h3>
        <p>{en?'A one-hour practice session tailored to your target role, with questions based on real hiring scenarios and individual feedback. Within 2 hours after the session ends, you receive a personalized written report by email with strengths, improvement priorities and practical next steps.':'Uma sessão de uma hora adaptada ao cargo desejado, com perguntas inspiradas em situações reais de seleção e feedback individual. Em até 2 horas após o término da sessão, você recebe por e-mail um relatório escrito personalizado com pontos fortes, prioridades de melhoria e próximos passos práticos.'}</p>
        <p class="mock-offer-small">{en?'New one-off service. Delivered by a professional with international recruiting experience. Not a proficiency certificate, hiring guarantee or ongoing course. Session notes are taken manually; no recording or AI meeting bot is currently enabled.':'Novo serviço avulso, conduzido por profissional com experiência em recrutamento internacional. Não é certificação de proficiência, garantia de contratação ou curso contínuo. O registro da sessão é feito por anotações; não há gravação ou bot de IA ativo neste momento.'}</p>
      </div>
      <div class="mock-offer-action">
        <p class="mock-price"><strong>R$ 80</strong><span>{en?'por sessão de 60 minutos':'por sessão de 60 minutos'}</span></p>
        <a class="button primary" href="#pedido-simulacao">{en?'Request a mock interview':'Solicitar minha simulação'} <span aria-hidden="true">↓</span></a>
        <span class="field-hint">{en?'Availability confirmed before any payment.':'Disponibilidade confirmada antes de qualquer pagamento.'}</span>
      </div>
    </article>
    <p class="lesson-alternatives">{en?'Looking for a different kind of support?':'Busca outro tipo de preparação?'}</p>
    <div class="lesson-options">
      <article class="lesson-option lesson-interviews"><p class="label">{en?'Preparing for an opportunity':'Preparação para uma oportunidade'}</p><h3>{en?'Job interviews in English':'Entrevistas em inglês'}</h3><p>{en?'Practice introducing yourself, talking about your experience, and answering follow-up questions. For ongoing preparation, we can work across multiple situations based on your background and the role you want.':'Pratique sua apresentação profissional, como contar suas experiências e responder a perguntas de acompanhamento. Para uma preparação continuada, podemos trabalhar diferentes situações considerando sua trajetória e o cargo desejado.'}</p><ul><li>{en?'Mock interviews and feedback':'Simulações e feedback'}</li><li>{en?'Clear answers in your own words':'Respostas claras, com suas palavras'}</li></ul></article>
      <article class="lesson-option"><p class="label">Business English</p><h3>{en?'English for work':'Inglês para o trabalho'}</h3><p>{en?'Work on a situation from your professional life: a meeting, a presentation, a conversation with coworkers, or international customer support.':'Trabalhe uma situação da sua vida profissional: uma reunião, uma apresentação, uma conversa com colegas ou atendimento internacional.'}</p><ul><li>{en?'Vocabulary in context':'Vocabulário aplicado ao seu contexto'}</li><li>{en?'Practice speaking and responding':'Prática de fala e interação'}</li></ul></article>
    </div>
    <div class="lesson-next"><div><h3>{en?'What would you like to prepare for?':'O que você precisa preparar?'}</h3><p>{en?'Tell me your goal and time frame. We can discuss an approach, availability, and pricing before you decide.':'Me conte seu objetivo e prazo. Conversamos sobre a abordagem, a disponibilidade e os valores antes de você decidir.'}</p></div>{active?<a class="button primary" href="#pedido-aulas">{en?'Ask about lessons':'Consultar aulas'}<span aria-hidden="true">↓</span></a>:<a class="button primary" href="https://www.linkedin.com/in/lucasmateus/">{en?'Ask about lessons on LinkedIn':'Consultar aulas pelo LinkedIn'}<span aria-hidden="true">↗</span></a>}</div>
    <p class="lesson-separation">{en?'Lessons involve working directly with me. For self-guided interview preparation, explore the separate Reta Final toolkit below.':'Nas aulas, você trabalha diretamente comigo. Para preparação autônoma, conheça a proposta do toolkit Reta Final na próxima seção.'}</p>
    <MockInterviewRequestForm lang={lang} />
    {active && <LessonRequestForm lang={lang} api={api} siteKey={siteKey} privacy={privacy} />}
  </div>
</section>
