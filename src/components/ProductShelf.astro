---
import {publishedProducts} from '../data/products';
interface Props {lang:'pt-BR'|'en-US'}
const {lang}=Astro.props;
const en=lang==='en-US';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<section class="band creation-band" id="criacoes" aria-labelledby="creation-title"><div class="wrap">
 <header class="section-heading"><div><p class="section-number">{en?'02':'03'} / {en?'Products':'Produtos'}</p><h2 id="creation-title">{en?'A guide to put ideas into practice.':'Um guia para colocar ideias em prática.'}</h2></div></header>
 {publishedProducts.map(product=>{const copy=product.copy[lang];return <article class="reia-feature" id={product.id}><img src={`${base}${product.image}`} class="reia-feature-art" alt={copy.alt} width="96" height="96" loading="lazy"/><div class="reia-feature-copy"><span class="status">{copy.status}</span><h3>{product.title}</h3><p>{copy.description}</p><a class="text-link" href={`${base}${product.page}`}>{copy.details} ↗</a></div><a class="text-link" href={product.checkout}>{copy.buy} ↗</a></article>;})}
</div></section>
